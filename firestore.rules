rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsCampaign(campaignId) {
      return signedIn() &&
        get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerUid == request.auth.uid;
    }

    match /public/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId}/apps/{appId}/data/{docId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/data/{docId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /campaigns/{campaignId} {
      // Links stay active until the owner deletes them or disables them.
      allow get: if (signedIn() && resource.data.ownerUid == request.auth.uid)
        || resource.data.active == true;
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'creatorName', 'loveName', 'question', 'active', 'createdAt'])
        && request.resource.data.creatorName is string
        && request.resource.data.creatorName.size() > 0
        && request.resource.data.creatorName.size() <= 60
        && request.resource.data.loveName is string
        && request.resource.data.loveName.size() > 0
        && request.resource.data.loveName.size() <= 60
        && request.resource.data.question in ['Do You Like Me?', 'Do You Love Me?']
        && request.resource.data.active == true;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /events/{eventId} {
        allow create: if get(/databases/$(database)/documents/campaigns/$(campaignId)).data.active == true
          && request.resource.data.keys().hasOnly(['type', 'visitorId', 'isRepeat', 'createdAt', 'recipientName', 'contact', 'campaignId'])
          && request.resource.data.type in ['visit', 'yes', 'no_attempt', 'details']
          && request.resource.data.visitorId is string
          && request.resource.data.visitorId.size() <= 80
          && request.resource.data.isRepeat is bool
          && request.resource.data.recipientName is string
          && request.resource.data.recipientName.size() <= 60
          && request.resource.data.contact is string
          && request.resource.data.contact.size() <= 120
          && request.resource.data.campaignId == campaignId;
        allow read: if ownsCampaign(campaignId);
        allow update: if false;
        allow delete: if ownsCampaign(campaignId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}